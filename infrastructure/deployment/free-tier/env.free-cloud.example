# ==============================================================================
# DRIVERYO 100% FREE CLOUD 3-TIER ARCHITECTURE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 2: APPLICATION & BACKEND CONFIGURATION (Render / Koyeb / Fly.io)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=10000
API_PREFIX=/api/v1
CORS_ORIGINS=https://driveryo.vercel.app,https://admin-driveryo.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# TIER 3: DATA TIER (Neon Serverless PostgreSQL & Upstash Redis)
# ------------------------------------------------------------------------------
# Neon.tech Free PostgreSQL (Free 0.5 GB, Autoscaling, SSL Enabled)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-solitary-hill-123456.ap-southeast-1.aws.neon.tech/driveryo?sslmode=require"

# Upstash Free Redis (10,000 Commands/day, Free Serverless Redis)
REDIS_URL="rediss://default:YOUR_REDIS_PASSWORD@ap-south-1.upstash.io:6379"

# Cloudflare R2 (S3 Compatible - 10 GB Free, Zero Egress Fees)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
S3_BUCKET_NAME=driveryo-documents
S3_PUBLIC_URL=https://pub-your-id.r2.dev

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=driveryo_super_secret_jwt_hmac_sha256_key_2026_production
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (Free Sandbox Modes)
# ------------------------------------------------------------------------------
# Razorpay Test Mode (Free test keys for UPI, Cards, NetBanking)
RAZORPAY_KEY_ID=rzp_test_DriveryoHyd2026Key
RAZORPAY_KEY_SECRET=DriveryoSecretKeyTest2026

# Google Maps Platform (Free $200 monthly recurring credit)
GOOGLE_MAPS_API_KEY=AIzaSyDriveryoFreePlatformKey2026

# Firebase Cloud Messaging (FCM - 100% Free Unlimited Push Notifications)
FIREBASE_PROJECT_ID=driveryo-hyd-prod
