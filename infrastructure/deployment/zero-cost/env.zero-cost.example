# ==============================================================================
# DRIVERYO ZERO-COST TO SCALE-READY ENVIRONMENT CONFIGURATION
# 100% Free Tiers with Zero-Downtime Scalability
# ==============================================================================

# ------------------------------------------------------------------------------
# TIER 2: APPLICATION & BACKEND CONFIGURATION (Koyeb / Render Free Web Service)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=https://driveryo.vercel.app,https://admin-driveryo.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# TIER 3: DATA TIER (Neon Serverless PostgreSQL & Upstash Redis Mumbai)
# ------------------------------------------------------------------------------
# Neon.tech Free Serverless PostgreSQL (0.5 GB Free, Autoscaling, SSL Required)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-solitary-hill-123456.ap-southeast-1.aws.neon.tech/driveryo?sslmode=require"

# Upstash Free Redis (10,000 Commands/day, Hosted in Mumbai ap-south-1)
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@ap-south-1.upstash.io:6379"

# Cloudflare R2 Object Storage (10 GB Free Storage Forever, ZERO Bandwidth Fees)
# Uses standard AWS S3 SDK (@aws-sdk/client-s3)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
S3_BUCKET_NAME=driveryo-kyc-documents
S3_PUBLIC_URL=https://pub-your-id.r2.dev

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=driveryo_zero_cost_scale_ready_secret_key_2026
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d

# ------------------------------------------------------------------------------
# THIRD-PARTY INTEGRATIONS (Free Sandbox Modes)
# ------------------------------------------------------------------------------
# Razorpay Free Test Mode (UPI, Cards, NetBanking, Instant refunds)
RAZORPAY_KEY_ID=rzp_test_DriveryoHyd2026Key
RAZORPAY_KEY_SECRET=DriveryoSecretKeyTest2026

# Google Maps Platform (Free $200 recurring monthly credit from Google)
GOOGLE_MAPS_API_KEY=AIzaSyDriveryoFreePlatformKey2026

# Firebase Cloud Messaging (FCM - 100% Free Unlimited Push Notifications)
FIREBASE_PROJECT_ID=driveryo-hyd-prod
