# ==============================================================================
# DRIVERYO PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real or test secrets.
# DO NOT commit real production credentials to source control.

# --- APPLICATION & ENVIRONMENT ---
NODE_ENV=development
APP_NAME=Driveryo
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
ADMIN_URL=http://localhost:3001
WS_URL=ws://localhost:4000
TIMEZONE=Asia/Kolkata
DEFAULT_CITY=Hyderabad
DEFAULT_CURRENCY=INR

# --- PORTS ---
PORT=4000
WEBSITE_PORT=3000
ADMIN_PORT=3001

# --- DATABASE (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres_driveryo@localhost:5432/driveryo_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# --- CACHE & QUEUES (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- SECURITY & AUTHENTICATION (JWT) ---
JWT_ACCESS_SECRET=driveryo_jwt_access_super_secret_development_key_2026
JWT_REFRESH_SECRET=driveryo_jwt_refresh_super_secret_development_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
BCRYPT_SALT_ROUNDS=12

# --- GOOGLE MAPS PLATFORM ---
# Separate keys for Web client, Mobile client, and Server-side routing/geocoding
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_TEST_MOCK_GOOGLE_MAPS_WEB_KEY
GOOGLE_MAPS_SERVER_KEY=AIzaSy_TEST_MOCK_GOOGLE_MAPS_SERVER_KEY
FLUTTER_GOOGLE_MAPS_KEY=AIzaSy_TEST_MOCK_GOOGLE_MAPS_MOBILE_KEY

# --- PAYMENT GATEWAY (Razorpay Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_driveryo_demo_key
RAZORPAY_KEY_SECRET=rzp_test_driveryo_demo_secret
RAZORPAY_WEBHOOK_SECRET=driveryo_webhook_secret_dev
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_driveryo_demo_key

# --- SMS OTP PROVIDER (MSG91 / Twilio) ---
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=mock_msg91_auth_key
MSG91_SENDER_ID=DRVRYO
MSG91_OTP_TEMPLATE_ID=mock_otp_template_id

# --- PUSH NOTIFICATIONS (Firebase Cloud Messaging) ---
FIREBASE_PROJECT_ID=driveryo-hyd
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@driveryo-hyd.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6mock\n-----END PRIVATE KEY-----\n"

# --- AWS S3 (Secure KYC Document & Receipt Storage) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=driveryo-documents-prod
AWS_ACCESS_KEY_ID=AKIA_MOCK_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=mock_aws_secret_access_key

# --- MONITORING & ERROR TRACKING ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=debug
